# From Garmin Connect (web) > Settings > Personal API Key
GARMIN_PERSONAL_API_KEY=

# Google sign-in (recommended; see README "Set up Google sign-in").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Make one with: npm run secret. Signs all OAuth tokens; changing it signs everyone out.
OAUTH_SIGNING_SECRET=
# The Google email(s) allowed to sign in, comma-separated, e.g. you@example.com
ACCOUNT_EMAIL=

# Optional fallback: secret-in-URL access (?key=...). Leave empty to keep it off.
# Make one with: npm run secret (at least 24 characters)
CONNECTOR_SECRET=

# Only for standalone.js behind an HTTPS proxy, e.g. https://garmin.example.com
PUBLIC_URL=
